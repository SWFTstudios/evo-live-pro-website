# Optional. The Studio defaults to the Evo Live Pro project and the production dataset.
# Use the development dataset for experiments so test content never touches the live site.
SANITY_STUDIO_PROJECT_ID=ax3lhw5y
SANITY_STUDIO_DATASET=production

# Where the visual editor loads the website from. Defaults to the live site.
# Set to http://localhost:3000 when running the website locally.
SANITY_STUDIO_PREVIEW_ORIGIN=
