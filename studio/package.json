{
  "name": "evo-live-pro-studio",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "dev": "sanity dev",
    "start": "sanity start",
    "typegen": "sanity schema extract --enforce-required-fields && sanity typegen generate",
    "validate": "sanity schema validate",
    "seed": "sanity exec scripts/seed.ts --with-user-token",
    "migrate": "sanity exec scripts/migrate-from-payload.ts --with-user-token"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/icons": "^5.3.0",
    "@sanity/vision": "^6.23.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^6.23.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^7",
    "@types/react": "^19.2.14",
    "eslint": "^10.8.1",
    "prettier": "^3.5",
    "typescript": "~6.0"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  }
}
