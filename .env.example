# A generated secret for Payload
PAYLOAD_SECRET=

# Sanity (the website only reads published content, server side). None of these are secrets.
# Pre-merge testing reads the seeded "development" dataset. At cutover, use "production" (see the plan, Phase 7).
SANITY_PROJECT_ID=ax3lhw5y
SANITY_DATASET=development
# Set to false to read straight from the API instead of the CDN (always fresh, slower).
SANITY_USE_CDN=true

# Server only, NEVER commit a real value. Lets the contact form store inquiries in Sanity.
# Create at sanity.io/manage -> API -> Tokens, role "Editor". In production: `pnpm wrangler secret put SANITY_API_WRITE_TOKEN`.
SANITY_API_WRITE_TOKEN=
