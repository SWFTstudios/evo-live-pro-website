{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The website: Next.js built for Cloudflare Workers by OpenNext (`pnpm run deploy`).
  // Content lives in Sanity, so the Worker needs no database or storage bindings.
  "name": "evo-live-pro-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": [
    // Node.js APIs for Next.js. https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // fetch() may only reach public URLs (Sanity's API). https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "vars": {
    // Which Sanity dataset the site reads. "development" holds seeded test content.
    // Switch to "production" once the real content has been migrated into it (see README, "Going live").
    "SANITY_DATASET": "development",
  },
  // Secrets are not stored here. Set them with:
  //   pnpm wrangler secret put SANITY_API_WRITE_TOKEN   (contact form, Sanity "Editor" token)
  //   pnpm wrangler secret put SANITY_API_READ_TOKEN    (visual editor drafts, Sanity "Viewer" token)
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
}
