{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evo-live-pro-website",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "STAGERA_API_BASE": "https://app.stagera.ai/api/v2"
  },
  // STAGERA_API_KEY is a secret: set it with `npx wrangler secret put STAGERA_API_KEY`
  // (or in the Cloudflare dashboard), never in this file.
  "observability": {
    "enabled": true
  }
}
